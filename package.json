{
  "name": "corviin-hub",
  "version": "0.1.0",
  "private": true,
  "description": "CORVIIN HUB — Internal operations platform for Corviin Group",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n \"web,api\" -c \"cyan,magenta\" \"npm -w apps/web run dev\" \"npm -w apps/api run dev\"",
    "dev:web": "npm -w apps/web run dev",
    "dev:api": "npm -w apps/api run dev",
    "build": "npm run build:shared && npm run build:prisma && npm run build:web && npm run build:api",
    "build:prisma": "node scripts/ensure-prisma-client.js && npm -w apps/api run prisma:generate",
    "postinstall": "node scripts/ensure-prisma-client.js",
    "build:shared": "npm -w packages/shared run build",
    "build:web": "npm -w apps/web run build",
    "build:api": "npm -w apps/api run build",
    "start": "node apps/api/dist/main.js",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md}\""
  },
  "devDependencies": {
    "concurrently": "^10.0.6",
    "prettier": "^3.4.0",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "@prisma/client": "^7.10.1",
    "prisma": "^7.10.1"
  },
  "engines": {
    "node": ">=20.0.0 <23.0.0"
  }
}
