# Application Configuration
NODE_ENV=development
API_PORT=3001
API_HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
APP_VERSION=0.1.0

# Database Configuration (PostgreSQL / Supabase)
# For Supabase pooler: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/corviin_hub?schema=public"

# Direct URL for migrations (bypasses connection pooler)
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/corviin_hub?schema=public"

# Dedicated integration test database
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/corviin_hub_test?schema=public"

# Cloudflare R2 Object Storage (S3-Compatible)
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=corviin-hub-assets
R2_ENDPOINT=https://your-cloudflare-account-id.r2.cloudflarestorage.com
R2_REGION=auto
R2_PRESIGNED_URL_EXPIRY_SECONDS=900
R2_PUBLIC_DOMAIN=
